{
  "name": "donkeyface-vibes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:pages": "npm run package && node scripts/pages.mjs",
    "package": "vite build && node scripts/package.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/pages.mjs && playwright test"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "7.3.1"
  }
}
